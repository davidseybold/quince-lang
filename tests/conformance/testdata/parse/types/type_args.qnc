// rule: grammar.type_args
// rule: grammar.type_arg
// rule: lex.no-shift-token
// mode: parse
// Type arguments are types in angle brackets, separated by commas, and a `uses` list may come
// last. A trailing comma may end them. Nested lists close with `>>`, which the lexer never
// makes one token, and a `>` before `=` closes them too.
fn args(
  a: List<List<Int>>,
  b: Map<String, List<Option<Int>>>,
  c: Pool<PgConn, PgError, uses Net>,
  d: Route<uses Db, Net>,
  e: Iter<Result<String, FsError>, uses Fs>,
) {
  let x: Option<Int>= y
}
fn empty(a: List<>) {} //~ E0016
fn trailing(a: Map<String, Int,>) {}
fn trailing_uses(a: Pool<uses Net,>, b: Route<
  uses Db, Net,
>) {}
fn only_comma(a: List<,>) {} //~ E0016
fn unclosed(a: List<Int) {} //~ E0017
fn uses_not_last(a: Pool<uses Net, (Int, Int)>) {} //~ E0016
