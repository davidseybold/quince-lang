// rule: grammar.type
// rule: grammar.type_path
// mode: parse
// A type is a type path with optional type arguments, the unit type `()`, a tuple of two or
// more types, or a function type, bare or in parentheses. Dotted names, `Self` and C names
// are all type paths: the parser doesn't look at case.
fn types(
  a: Int,
  b: http.Request,
  c: Self.Item,
  d: Ptr<sqlite3>,
  e: (),
  f: (Int, String),
  g: (Int, List<String>, (Bool, Float),),
  h: fn(Int) -> Int,
  i: (fn() uses Io),
) {}
const ORIGIN: (Int, Int) = 0
fn one_trailing(a: (Int,)) {} //~ E0016
fn no_name(a: http.) {} //~ E0016
fn not_a_type(a: 1) {} //~ E0016
