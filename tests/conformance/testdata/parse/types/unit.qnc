// rule: type.unit
// mode: parse
// The unit type is written `Unit`, and its one value `()`. So `()` is a value, and where a
// type goes it is an error.
fn done() -> Unit {
  ()
}

fn save() -> Result<Unit, String> {
  Ok(())
}

fn returns_unit() -> () {} //~ E0016
fn takes_unit(u: ()) {} //~ E0016
const NOTHING: Result<(), String> = Ok(()) //~ E0016
