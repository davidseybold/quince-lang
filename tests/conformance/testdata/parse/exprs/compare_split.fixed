// rule: expr.op.compare.split
// mode: parse
// A chain whose operators point the same way gets a fix that repeats each middle operand.
// A chain that mixes them gets none, which compare_split.fixed pins by leaving it as it is.
fn f(a: Int, b: Int, c: Int) {
  let up = a < b && b < c //~ E0020
  let inside = 0 <= a && a < c //~ E0020
  let down = a > b && b >= c //~ E0020
  let same = a == b && b == c //~ E0020
  let long = a < b && b < c && c < 10 //~ E0020
  let mixed = a < b > c //~ E0020
  let mixed_eq = a < b >= c //~ E0020
  let not_equal = a != b != c //~ E0020
  let equal_then_not = a == b != c //~ E0020
  let call = g<1>(a) //~ E0020
}
