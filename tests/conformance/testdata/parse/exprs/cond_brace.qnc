// rule: expr.block.cond-brace
// mode: parse
// In the condition of an `if` or `while`, the subject of a `match`, the iterable of a `for`,
// the condition of a contract and the value of a `with` handler, `{` where an expression
// starts always starts the block, so a map literal there is written in parentheses. The braces
// of a closure, `concurrent`, `select`, `with` or `background` are that construct's own.
fn f(m: Map<String, Int>, var n: Int) {
  if m == ({:}) {
    log("empty")
  }
  while m != ({"a": n}) {
    n += 1
  }
  if contains(m, {"a": 1}) {
    log("found")
  }
  if m == {:} { //~ E0016
    log("empty")
  }
  if {"a": 1}.len() > 0 { //~ E0016
    log("one")
  }
  while n > { //~ E0016
    n -= 1
  }
  let size = match ({"a": 1}).len() {
    0 => "none",
    _ => "some",
  }
  for (key, value) in ({"a": 1}) {
    log(key)
  }
  let kind = match {"a": 1} { //~ E0016
    _ => "map",
  }
  for entry in {"a": 1} { //~ E0016
    log("entry")
  }
  if fn(x: Int) { x > 0 }(n) {
    log("positive")
  }
  let pair = match concurrent { spawn a(), spawn b() } {
    (x, y) => x + y,
  }
  if select { x = c.receive() => x.is_some(), } {
    log("ready")
  }
  while with Clock = clock { done() } {
    n += 1
  }
  if background(bg: TaskScope) { serve(bg) }.is_ok() {
    log("served")
  }
  with Config = ({"port": 80}) {
    serve()
  }
  with Config = {"port": 80} { //~ E0016
    serve()
  }
  with Db = { //~ E0016
    serve()
  }
}

fn contracts(m: Map<String, Int>) -> Int
  requires m != ({:})
  ensures(r) r > 0 && m.contains(fn(k: String) { k.len() > r })
{
  1
}

fn map_in_contract(m: Map<String, Int>) requires m == {:} { //~ E0016
  log("empty")
}

fn no_condition(n: Int) requires { n } //~ E0016

fn body_after(n: Int) -> Int requires n > { //~ E0016
  n
}

