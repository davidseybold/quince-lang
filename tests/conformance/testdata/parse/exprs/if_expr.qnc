// rule: grammar.if_expr
// mode: parse
// `if` takes a condition and a block, and optionally `else` with another `if` or a block. It
// is an expression, so it can be a value.
fn sign(n: Int) -> Int {
  if n < 0 { -1 } else if n == 0 { 0 } else { 1 }
}

fn f(n: Int) {
  if n > 0 {
    log("positive")
  }
  if n > 0 {
    log("positive")
  } else {
    log("not positive")
  }
  let abs = if n < 0 { -n } else { n }
  let size = if n < 10 {
    "small"
  } else if n < 100 {
    "medium"
  } else {
    "large"
  }
  let nested = if n > 0 { if n > 1 { 2 } else { 1 } } else { 0 }
  if n > 0 log("positive") //~ E0016
  if n > 0 { log("positive") } else log("no") //~ E0016
  if n > 0 { log("positive") } else //~ E0016
}
