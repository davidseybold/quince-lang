// rule: expr.jump.expr
// rule: expr.op.keyword-forms
// mode: parse
// `return` takes an optional expression, and `break` and `continue` take none. They are
// expressions, so they can stand in a match arm, but keyword forms, not operators, so none of
// them is an operand. `return expr` takes everything to its right.
fn f(xs: List<Int>, x: Option<Int>) -> Int {
  for n in xs {
    if n < 0 { continue }
    if n > 9 { break }
  }
  let v = match x {
    Some(v) => v,
    None => return 0,
  }
  if v > 1 {
    return v * 2 + 1
  }
  return v
}

fn g(done: Bool) {
  if done {
    return
  }
  let x = 1 + return 2 //~ E0016
  let y = -return //~ E0016
}
