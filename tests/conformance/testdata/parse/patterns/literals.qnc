// rule: pat.negative
// rule: expr.range.pattern
// mode: parse
// A literal is a pattern, and so is a range of two literals, with `..` or `..=`. A numeric
// literal pattern or a range bound may start with `-`.
fn f(n: Int, x: Float, c: Char, s: String, b: Bool) {
  let zero = n is 0
  let negative = n is -5
  let small = x is -1.5
  let digit = n is 1..=9
  let low = n is 0..10
  let below = n is -10..=-1
  let letter = c is 'a'..='z'
  let get = s is "GET"
  let yes = b is true
  let spaced = n is - 5
  let named = n is -m //~ E0016
  let text = s is -"a" //~ E0016
  let open = n is 1.. + 2 //~ E0016
  let bound = n is 1..m //~ E0016
}
