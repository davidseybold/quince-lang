// rule: grammar.place
// rule: stmt.assign.stmt
// rule: stmt.assign.place
// mode: parse
// Assignment is a statement: a place, `=` or a compound assignment, and an expression. A
// place is a name or `self`, followed by fields, tuple positions and indexes. Anything else
// on the left is an error.
impl Counter {
  fn bump(var self, by: Int) {
    self.count += by
    self.history[0] = by
  }
}

fn f(var xs: List<Int>, var grid: List<List<Int>>, i: Int) {
  var total = 0
  var pair = (1, (2, 3))
  var user = load()
  total = 1
  total += 2
  total -= 1
  total *= 3
  total /= 2
  total %= 5
  xs[i] = total
  xs[i + 1] -= 1
  grid[i][0] = 1
  pair.0 = 4
  pair.1.0 = 5
  user.address.city = "Oslo"
  total =
    xs[0] + 1
  load() = 1 //~ E0026
  total + 1 = 2 //~ E0026
  xs.len() = 0 //~ E0026
  (total) = 3 //~ E0026
  1 = total //~ E0026
  user.save()? = 1 //~ E0026
}
