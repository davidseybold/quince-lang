// rule: lex.lit.string.interp
// mode: parse
// A string interpolates with {}, so a { always opens an interpolation, and braces
// with no name in them are an error. A $ before the brace is plain text.
fn f(name: String, amount: Int) {
  let a = "hello {name}"
  let b = "{name}{amount}"
  let c = "Total: ${amount}"
  let d = "{name}, you owe {amount}."
  let e = "{}" //~ E0007
}
