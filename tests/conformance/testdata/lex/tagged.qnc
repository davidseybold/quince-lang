// rule: lex.lit.tagged
// mode: parse
// The tags are url, re, dur and ts. Any other identifier glued to a quote is an unknown
// tag, including f, since every " string already interpolates. A keyword is never a tag,
// so test"name" is a test.
fn f() -> List<String> {
  let site = url"https://api.example.com/orders"
  let email = re"^[^@]+@[^@]+$"
  let timeout = dur"30s"
  let epoch = ts"2000-01-01T00:00:00Z"
  let name = "Ada"
  let greeting = f"hello {name}" //~ E0010
  let unknown = foo"x" //~ E0010
  let open = bar"never closed
  //~^ E0010
  [greeting]
}

test"tags never start with a keyword" {
}
