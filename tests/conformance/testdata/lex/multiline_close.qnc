// rule: lex.lit.multiline-close
// mode: parse
// The closing """ is the first thing on its line after its indentation, and code may
// follow it there. Elsewhere quotes are text, and a line that starts with """ writes it \""".
fn f() -> List<String> {
  let a = """
    quotes inside a line: """ and "" and " are text
    \""" starts this line
    """
  [a, """
    code follows the closing quotes
    """]
}
