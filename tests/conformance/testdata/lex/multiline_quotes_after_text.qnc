// rule: lex.lit.multiline-quotes
// mode: parse
// Outside the closing line, """ in a multi-line string is an error, so quotes after text
// are never a valid close, and never silently join the next string into this one.
const USAGE: String = """
  quince test"""
//~^ E0012
const NOTE: String = """
  closed on a line of its own
  """
